void competition_initialize() {}

/**
 * Runs the user autonomous code. This function will be started in its own task
 * with the default priority and stack size whenever the robot is enabled via
 * the Field Management System or the VEX Competition Switch in the autonomous
 * mode. Alternatively, this function may be called in initialize or opcontrol
 * for non-competition testing purposes.
 *
 * If the robot is disabled or communications is lost, the autonomous task
 * will be stopped. Re-enabling the robot will restart the task, not re-start it
 * from where it left off.
 */
void autonomous() {

    chassis.setPose(-16.5, -3.75, -90);

    //Move to the point in between the right loader and long goal to prepare for scoring
	chassis.moveToPoint(-46.5, 0, 10000, lemlib::MoveToPointParams{.maxSpeed = 90}); 
    //Move to scoring position

    chassis.turnToHeading(180, 5000, lemlib::TurnToHeadingParams{.maxSpeed = 65});

    pros::delay(50);

	//Prep pneumatic systems for loading
	tongueMech.set_value(true);

	lift.set_value(true);

	scoringFlap.set_value(true); //Scoring flap is closed

	//Move into loader
	chassis.moveToPoint(-46.5, -16, 4500, lemlib::MoveToPointParams{.maxSpeed = 60});
	//Original::48.5
	
	pros::delay(50);

	//Intake loader
	intakeMotors.move(127);

	pros::delay(2500);

	intakeMotors.move(0);

	//Back out of loader
	chassis.moveToPoint(-46.5, 4, 10000, 
		lemlib::MoveToPointParams{.forwards = false, .maxSpeed = 50});

        pros::delay(50);

        tongueMech.set_value(false);

    chassis.turnToHeading(135, 5000, lemlib::TurnToHeadingParams{.maxSpeed = 60});

    outtakeMotors.move_voltage(-12000);

    pros::delay(500);

    outtakeMotors.move_voltage(0);

    chassis.turnToHeading(180, 5000, lemlib::TurnToHeadingParams{.maxSpeed = 65});

    pros::delay(50);

	//Prep pneumatic systems for loading
	tongueMech.set_value(true);

    chassis.moveToPoint(-46.5, -15.7, 4500, lemlib::MoveToPointParams{.maxSpeed = 55});
	//Original::48.5

	pros::delay(50);

	//Intake loader
	intakeMotors.move(127);

	pros::delay(2500);

	intakeMotors.move(0);

    chassis.moveToPoint(-49, 4, 10000, 
		lemlib::MoveToPointParams{.forwards = false, .maxSpeed = 80});

	pros::delay(10);

	//Open scoring flap
	scoringFlap.set_value(false);

	//Face long goal
	chassis.turnToHeading(0, 5000, lemlib::TurnToHeadingParams{.maxSpeed = 70}); //Face the goal


	//Raise tongue mech
	tongueMech.set_value(false);

	//Move to the goal and score
	chassis.moveToPoint(-49, 16.5, 2000, lemlib::MoveToPointParams{.maxSpeed = 80}); //Move forward to score
	//49.75 original value

	pros::delay(600);

	intakeMotors.move(127);

	pros::delay(2000);

	intakeMotors.move(0);
	}
void opcontrol() {
	
    // loop forever
    while (true) {


        // get left y and right x positions
        int rightY = controller.get_analog(pros::E_CONTROLLER_ANALOG_LEFT_Y);
        int leftX = controller.get_analog(pros::E_CONTROLLER_ANALOG_RIGHT_X);

        // move the robot
        chassis.arcade(rightY, leftX); //Arcade drive control is based around 1 joystick
        score(); //Score on tallest goals

        
        /*IF condition checks if R1 and R2 are being pressed simultaneously (scoring mode)
        This is required to keep outtake from spinning in the middle of scoring mode*/
        if (!controller.get_digital(pros::E_CONTROLLER_DIGITAL_R1) || 
            !controller.get_digital(pros::E_CONTROLLER_DIGITAL_R2)) 
        {
        controlIntake();
        controlOuttake();
        }

        controlLift();
        toungeMech();
        descoreArm();
        //colorSort();


        // Get odometry values from chassis (x, y, heading)
        double x = chassis.getPose().x;
        double y = chassis.getPose().y;
        double heading = chassis.getPose().theta;

        // Print the odometry values to the controller screen
        controller.print(0, 0, "Y: %.2f, X: %.2f", y , x);

        
        // delay to save resources
        pros::delay(25);
    }

}
